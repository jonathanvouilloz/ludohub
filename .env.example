# Neon Postgres (serverless)
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/ludohub?sslmode=require

# Better Auth — générer avec: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-here

# Vercel Blob
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# URL publique de l'app (sans slash final)
PUBLIC_APP_URL=http://localhost:5173

# Origines navigateur autorisées pour l'API publique (séparées par des virgules).
# Les appels serveur-à-serveur sans en-tête Origin restent autorisés.
PUBLIC_API_ALLOWED_ORIGINS=http://localhost:4321

# API de l'extension Orphée. Secret dédié (32 caractères aléatoires minimum)
# pour le HMAC des codes de liaison ; origines exactes séparées par des virgules.
EXTENSION_AUTH_SECRET=replace-with-a-separate-long-random-secret
EXTENSION_API_ALLOWED_ORIGINS=chrome-extension://replace-with-real-extension-id

# Secret Bearer du planificateur pour la purge quotidienne des adhésions traitées.
CRON_SECRET=replace-with-a-long-random-secret

# Super Admin (Jonathan)
SUPER_ADMIN_PASSWORD=your-admin-password-here

# Newsletter (Resend) — domaine ludohub.ch vérifié dans Resend
RESEND_API_KEY=re_xxx
NEWSLETTER_FROM=noreply@ludohub.ch
# Secret de signature des webhooks Resend (bounces/plaintes) — Svix
RESEND_WEBHOOK_SECRET=whsec_xxx
